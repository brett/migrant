#!/usr/bin/env bash
# Example post-up hook: sync the host timezone into the VM.
# Runs after the VM is fully ready (IP assigned, SSH available, provisioned).
#
# Available environment variables:
#   MIGRANT_VM_NAME   — VM name from the Migrantfile
#   MIGRANT_VM_DIR    — absolute path to the VM directory
#   MIGRANT_HOOK      — hook name (post-up)
#   MIGRANT_TRIGGER   — command that triggered this hook (up)
#   MIGRANT_VM_IP     — VM IP address
#
# All Migrantfile variables (VM_NAME, RAM_MB, NETWORKS, etc.) are also present.
#
# Assumes the host is Arch Linux, where /etc/localtime is a symlink into the
# zoneinfo tree. The guest is systemd-based, so timedatectl applies it.
# MIGRANT_DIR points 'migrant ssh' at this VM regardless of the hook's cwd.

set -euo pipefail

tz=$(readlink -f /etc/localtime)
tz=${tz##*/zoneinfo/}

MIGRANT_DIR="$MIGRANT_VM_DIR" migrant ssh -- sudo timedatectl set-timezone "$tz"
