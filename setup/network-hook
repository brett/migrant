#!/bin/bash
# Managed by migrant
# Libvirt network hook args: $1=network-name $2=operation $3=sub-operation $4=extra
# Neither saved nor restored: the sysctl is an attribute of virbr-migrant, and
# libvirt creates the bridge with this hook and removes it when the network is
# destroyed, taking the setting with it. A value an administrator set on this
# bridge by hand is overridden until then.
if [[ "$1" == "migrant" && "$2" == "started" ]]; then
  sysctl -w "net.ipv4.conf.virbr-migrant.rp_filter=0"
fi
